generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

enum FaceMode {
  PLAIN
  PAINT
  BEHIND_MASTHEAD
  NECK_DOWN
}

enum TwinStatus {
  INVITED
  ACCEPTED
}

enum TwinRole {
  INVITER
  INVITEE
}

enum TwinVisibility {
  PRIVATE
  SOLO
  JOINT
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  email                  String?               @unique
  status                 UserStatus            @default(ACTIVE)
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  profile                Profile?
  emailCredential        EmailCredential?
  authSessions           AuthSession[]
  notificationSettings   NotificationSettings?
  choices                UserDailyChoice[]
  mediaAssets            MediaAsset[]
  issues                 Issue[]
  likes                  Like[]
  scraps                 Scrap[]
  readerLines            ReaderLine[]
  subscriptionsMade      Subscription[]        @relation("SubscriptionsMade")
  magazineSubscribers    Subscription[]        @relation("MagazineSubscribers")
  restoredColors         RestoredColor[]
  friendshipsAsA         Friendship[]          @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]          @relation("FriendshipUserB")
  friendRequestsSent     FriendRequest[]       @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]       @relation("FriendRequestReceiver")
  twinParticipations     TwinParticipation[]
  garments               Garment[]
  shareLinksCreated       ShareLink[]           @relation("ShareLinkCreator")
  reportsMade             Report[]              @relation("ReportReporter")

  @@map("users")
}

model NotificationSettings {
  userId    String   @id @map("user_id") @db.Uuid
  enabled   Boolean  @default(true)
  newIssue  Boolean  @default(true) @map("new_issue")
  reactions Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model EmailCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  masthead   String   @unique @db.VarChar(10)
  bio        String   @default("") @db.VarChar(80)
  issueCount Int      @default(0) @map("issue_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Color {
  id             String              @id @db.VarChar(32)
  nameKo         String              @map("name_ko") @db.VarChar(32)
  nameEn         String              @map("name_en") @db.VarChar(32)
  hex            String              @db.Char(7)
  sortOrder      Int                 @unique @map("sort_order") @db.SmallInt
  paletteColors  DailyPaletteColor[]
  choices        UserDailyChoice[]
  issues         Issue[]
  restoredColors RestoredColor[]
  twinChoices    TwinParticipation[] @relation("TwinChoiceColor")
  twinCandidates TwinCandidate[]
  twinPosts      TwinPost[]

  @@map("colors")
}

model DailyPalette {
  id          String              @id @default(uuid()) @db.Uuid
  serviceDate DateTime            @unique @map("service_date") @db.Date
  createdAt   DateTime            @default(now()) @map("created_at")
  colors      DailyPaletteColor[]

  @@map("daily_palettes")
}

model DailyPaletteColor {
  dailyPaletteId String       @map("daily_palette_id") @db.Uuid
  colorId        String       @map("color_id") @db.VarChar(32)
  position       Int          @db.SmallInt
  dailyPalette   DailyPalette @relation(fields: [dailyPaletteId], references: [id], onDelete: Cascade)
  color          Color        @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([dailyPaletteId, colorId])
  @@unique([dailyPaletteId, position])
  @@map("daily_palette_colors")
}

model UserDailyChoice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  serviceDate DateTime  @map("service_date") @db.Date
  colorId     String    @map("color_id") @db.VarChar(32)
  lockedAt    DateTime? @map("locked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  color       Color     @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([userId, serviceDate])
  @@index([serviceDate, colorId])
  @@map("user_daily_choices")
}

model MediaAsset {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  storageKey String      @unique @map("storage_key")
  status     MediaStatus @default(PENDING)
  mimeType   String      @map("mime_type") @db.VarChar(128)
  sizeBytes  Int         @map("size_bytes")
  width      Int?
  height     Int?
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  issue      Issue?
  twinPost   TwinPost?

  @@index([ownerId, status])
  @@map("media_assets")
}

model Issue {
  id          String       @id @default(uuid()) @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  serviceDate DateTime     @map("service_date") @db.Date
  issueNumber Int          @map("issue_number")
  colorId     String       @map("color_id") @db.VarChar(32)
  mediaId     String       @unique @map("media_id") @db.Uuid
  caption     String       @db.VarChar(280)
  faceMode    FaceMode     @map("face_mode")
  publishedAt DateTime     @default(now()) @map("published_at")
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  color       Color        @relation(fields: [colorId], references: [id], onDelete: Restrict)
  media       MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  likes       Like[]
  scraps      Scrap[]
  readerLines ReaderLine[]
  garments    IssueGarment[]
  shareLinks  ShareLink[]
  reports     Report[]

  @@unique([authorId, serviceDate])
  @@unique([authorId, issueNumber])
  @@index([serviceDate, colorId, publishedAt])
  @@map("issues")
}

model Garment {
  id         String         @id @default(uuid()) @db.Uuid
  ownerId    String         @map("owner_id") @db.Uuid
  kind       String         @db.VarChar(20)
  name       String         @default("") @db.VarChar(40)
  note       String         @default("") @db.VarChar(20)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  issueLinks IssueGarment[]

  @@index([ownerId, createdAt, id])
  @@map("garments")
}

model IssueGarment {
  issueId    String   @map("issue_id") @db.Uuid
  garmentId  String   @map("garment_id") @db.Uuid
  position   Int      @db.SmallInt
  todayColor Boolean  @default(false) @map("today_color")
  x          Float?
  y          Float?
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  garment    Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@id([issueId, garmentId])
  @@unique([issueId, position])
  @@map("issue_garments")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([issueId, createdAt])
  @@map("likes")
}

model Scrap {
  userId    String   @map("user_id") @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([issueId, createdAt])
  @@map("scraps")
}

model ReaderLine {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  text      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([issueId, createdAt, id])
  @@map("reader_lines")
}

model Subscription {
  subscriberId String   @map("subscriber_id") @db.Uuid
  magazineId   String   @map("magazine_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  subscriber   User     @relation("SubscriptionsMade", fields: [subscriberId], references: [id], onDelete: Cascade)
  magazine     User     @relation("MagazineSubscribers", fields: [magazineId], references: [id], onDelete: Cascade)

  @@id([subscriberId, magazineId])
  @@index([magazineId, createdAt])
  @@map("subscriptions")
}

model RestoredColor {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  serviceDate DateTime @map("service_date") @db.Date
  colorId     String   @map("color_id") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  color       Color    @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@unique([userId, serviceDate])
  @@index([userId, serviceDate])
  @@map("restored_colors")
}

model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, createdAt, id])
  @@index([userBId, createdAt, id])
  @@map("friendships")
}

model FriendRequest {
  id         String   @id @default(uuid()) @db.Uuid
  pairKey    String   @unique @map("pair_key") @db.VarChar(73)
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  sender     User     @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, createdAt, id])
  @@map("friend_requests")
}

model Twin {
  id             String              @id @default(uuid()) @db.Uuid
  serviceDate    DateTime            @map("service_date") @db.Date
  status         TwinStatus          @default(INVITED)
  acceptedAt     DateTime?           @map("accepted_at")
  publishedAt    DateTime?           @map("published_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  participations TwinParticipation[]
  shareLinks     ShareLink[]

  @@index([serviceDate, status])
  @@map("twins")
}

model ShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @map("creator_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  issueId   String?  @map("issue_id") @db.Uuid
  twinId    String?  @map("twin_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  creator   User     @relation("ShareLinkCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  twin      Twin?    @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([twinId])
  @@map("share_links")
}

model Report {
  id         String      @id @default(uuid()) @db.Uuid
  reporterId String      @map("reporter_id") @db.Uuid
  issueId    String      @map("issue_id") @db.Uuid
  lineId     String?     @map("line_id") @db.Uuid
  reason     String      @db.VarChar(32)
  details    String      @default("") @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at")
  reporter   User        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  issue      Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  line       ReaderLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([issueId])
  @@index([lineId])
  @@map("reports")
}

model TwinParticipation {
  twinId        String          @map("twin_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  serviceDate   DateTime        @map("service_date") @db.Date
  role          TwinRole
  choiceColorId String?         @map("choice_color_id") @db.VarChar(32)
  visibility    TwinVisibility?
  consentedAt   DateTime?       @map("consented_at")
  twin          Twin            @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  choiceColor   Color?          @relation("TwinChoiceColor", fields: [choiceColorId], references: [id], onDelete: Restrict)
  candidates    TwinCandidate[]
  post          TwinPost?

  @@id([twinId, userId])
  @@unique([userId, serviceDate])
  @@unique([twinId, role])
  @@map("twin_participations")
}

model TwinCandidate {
  twinId      String            @map("twin_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  colorId     String            @map("color_id") @db.VarChar(32)
  position    Int               @db.SmallInt
  participant TwinParticipation @relation(fields: [twinId, userId], references: [twinId, userId], onDelete: Cascade)
  color       Color             @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([twinId, userId, colorId])
  @@unique([twinId, userId, position])
  @@map("twin_candidates")
}

model TwinPost {
  twinId      String            @map("twin_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  mediaId     String            @unique @map("media_id") @db.Uuid
  colorId     String            @map("color_id") @db.VarChar(32)
  createdAt   DateTime          @default(now()) @map("created_at")
  participant TwinParticipation @relation(fields: [twinId, userId], references: [twinId, userId], onDelete: Cascade)
  media       MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  color       Color             @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@id([twinId, userId])
  @@map("twin_posts")
}
