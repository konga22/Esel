# 로컬 개발용 값이다. 비밀번호 esel_dev는 compose.yaml의 개발용 DB와 같고, 운영에서는 쓰지 않는다.
# 운영(NODE_ENV=production)에서는 CORS_ORIGINS를 실제 앱 주소로 꼭 정해야 서버가 시작한다.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://esel:esel_dev@localhost:5432/esel?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:4173
SERVICE_TIME_ZONE=Asia/Seoul
MEDIA_STORAGE_ROOT=./data/media
