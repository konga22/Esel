{
  "name": "esel",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web --output-dir .codex/temp/prototype/20260905-esel-gallery/src",
    "preview": "python3 scripts/serve-preview.py",
    "preview:design": "python3 -m http.server 4177 --bind 127.0.0.1 --directory .codex/temp/prototype/20260906-minimal-gallery/src",
    "test:design": "node --test .codex/temp/prototype/20260906-minimal-gallery/tests/*.test.cjs",
    "design:build": "node .codex/temp/prototype/20261003-cover-sns/generator/gen-join.mjs && node .codex/temp/prototype/20261003-cover-sns/generator/gen-boards.mjs",
    "check:harness": "node scripts/check-harness.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
